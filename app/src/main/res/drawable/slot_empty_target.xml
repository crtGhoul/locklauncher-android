<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle frosted glass circular target card -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1F2438" />
            <stroke
                android:width="1.5dp"
                android:color="#35FFFFFF"
                android:dashWidth="4dp"
                android:dashGap="3dp" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
</layer-list>

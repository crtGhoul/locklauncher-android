<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle frosted glass circular target card -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#45FFFFFF"
                android:dashWidth="5dp"
                android:dashGap="4dp" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
    <!-- Minimalist subtle plus in center -->
    <item
        android:top="20dp"
        android:bottom="20dp"
        android:left="27dp"
        android:right="27dp">
        <shape android:shape="rectangle">
            <solid android:color="#60FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item
        android:top="27dp"
        android:bottom="27dp"
        android:left="20dp"
        android:right="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#60FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA000000"
    android:gravity="center"
    android:padding="24dp">

    <!-- Center Floating Glass Card -->
    <LinearLayout
        android:id="@+id/folder_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/dock_card"
        android:orientation="vertical"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Folder Header (Title, Rename, + Add, Close) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/folder_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="📁 Folder"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_folder_rename"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_ghost"
                    android:text="✏️"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_folder_add_app"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_accent"
                    android:text="＋ Add"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_folder_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_ghost"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Folder Apps Grid -->
        <GridView
            android:id="@+id/folder_grid"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:numColumns="4"
            android:verticalSpacing="12dp"
            android:horizontalSpacing="4dp"
            android:gravity="center"
            android:overScrollMode="never" />

        <!-- Empty Hint -->
        <TextView
            android:id="@+id/folder_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Folder is empty\nTap '＋ Add' to add apps!"
            android:textColor="#9AA0B4"
            android:textSize="14sp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>

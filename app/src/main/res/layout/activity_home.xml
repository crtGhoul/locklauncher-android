<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Drag Action Bar (Drop targets for Remove / Options) -->
    <LinearLayout
        android:id="@+id/drag_action_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="#E610121C"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/drag_action_remove"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/dock_card"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="🗑️ Drop to Remove"
            android:textColor="#FF5A5A"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/drag_action_options"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/dock_card"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="⚙️ Drop for Options"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Top Launcher Header (Clock, Date, Battery, Profile & Settings) -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true">

                <TextView
                    android:id="@+id/home_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#AA000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <TextView
                    android:id="@+id/home_date_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#DDEEFA"
                    android:textSize="14sp"
                    android:shadowColor="#AA000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <!-- At a Glance Smart Bar -->
                <LinearLayout
                    android:id="@+id/home_glance_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/glance_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/dock_card"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/glance_event"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/dock_card"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/glance_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/dock_card"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Launcher Settings Button -->
            <Button
                android:id="@+id/btn_home_settings"
                android:layout_width="64dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_ghost"
                android:text="Config"
                android:textSize="11.5sp"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <!-- Fluent Glass Segmented Profile Controller -->
        <LinearLayout
            android:id="@+id/home_tabs_container"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tab_segment_container"
            android:orientation="horizontal">

            <Button
                android:id="@+id/home_tab_p0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab_active_pill"
                android:text="Default"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/home_tab_p1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Profile 2"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#BBFFFFFF" />

            <Button
                android:id="@+id/home_tab_p2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Profile 3"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#BBFFFFFF" />
        </LinearLayout>

        <!-- Live Music Square Widget (Nothing OS / OxygenOS 15 Top-Left Music Square + Tap to Open) -->
        <LinearLayout
            android:id="@+id/home_now_playing_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="62dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/dock_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <!-- Album / Brand Artwork Square -->
            <ImageView
                android:id="@+id/now_playing_art"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher"
                android:contentDescription="Now Playing Artwork" />

            <LinearLayout
                android:id="@+id/now_playing_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/now_playing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Now Playing" />

                <TextView
                    android:id="@+id/now_playing_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Tap to open player ↗" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_media_prev"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_media_toggle"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⏸"
                android:textColor="#FF4B4B"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_media_next"
                android:layout_width="34dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_media_open"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:background="@drawable/btn_ghost"
                android:text="OPEN ↗"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Minimalist Clean Home Screen "Apps / Launcher" Toggle Pill -->
    <LinearLayout
        android:id="@+id/btn_toggle_apps_pill"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_above="@id/bottom_bar"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/tab_segment_container"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_toggle_apps_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apps"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#AA000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Bottom Action Bar (App Drawer Search & Add Web App) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Search Bar: Tap to open Searchable App Drawer -->
        <LinearLayout
            android:id="@+id/home_search_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_bar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/home_search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:text="Search apps, web, or math..."
                android:textColor="#BBFFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_quick_add_widget"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/dock_card"
                android:text="Widgets"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_quick_add_web"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/btn_accent"
                android:text="+ Web App"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live Widgets Container (AppWidgetHost) -->
    <LinearLayout
        android:id="@+id/home_widgets_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_container"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp" />

    <!-- Center Shortcuts Grid -->
    <GridView
        android:id="@+id/home_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/home_widgets_container"
        android:layout_above="@id/bottom_bar"
        android:numColumns="4"
        android:verticalSpacing="12dp"
        android:horizontalSpacing="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fadingEdge="none"
        android:gravity="center" />

    <!-- Empty State Hint -->
    <TextView
        android:id="@+id/home_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="No shortcuts in this profile yet.\nTap '+ Web App' below or Config to add apps."
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:padding="20dp"
        android:background="@drawable/dock_card"
        android:visibility="gone" />

</RelativeLayout>
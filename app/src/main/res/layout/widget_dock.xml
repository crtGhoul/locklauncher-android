                <TextView android:id="@+id/slot13_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#D8FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slot14" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <ImageView android:id="@+id/slot14_icon" android:layout_width="50dp" android:layout_height="50dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/slot14_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#D8FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slot15" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <ImageView android:id="@+id/slot15_icon" android:layout_width="50dp" android:layout_height="50dp" android:scaleType="fitCenter" />

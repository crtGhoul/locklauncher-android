<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/web_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#090A0F">

    <!-- Sleek Top Utility Bar (Hidden by default in Installed Standalone App Mode;
         when visible, sits at the TOP so it never blocks bottom web player controls) -->
    <LinearLayout
        android:id="@+id/web_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_alignParentTop="true"
        android:background="#F210131C"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Return / Back Button -->
        <TextView
            android:id="@+id/btn_web_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Forward Button -->
        <TextView
            android:id="@+id/btn_web_forward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Restart / Reload Button -->
        <TextView
            android:id="@+id/btn_web_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:background="#28FFFFFF" />

        <!-- Domain / App Title Pill (Tap for PiP, OLED Saver, Sleep Timer, Install App) -->
        <TextView
            android:id="@+id/text_web_domain"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Installed App"
            android:textColor="#EEFFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <!-- 1-Tap Install as App Button -->
        <TextView
            android:id="@+id/btn_install_webapp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/dock_card"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"
            android:text="＋ Install"
            android:textColor="#6EE7B7"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

        <!-- Immersive Fullscreen Toggle Button -->
        <TextView
            android:id="@+id/btn_toggle_fullscreen"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Tuck / Hide Top Bar into Installed App Mode -->
        <TextView
            android:id="@+id/btn_hide_top_bar"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▲"
            android:textColor="#BBFFFFFF"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Close / Exit Button -->
        <TextView
            android:id="@+id/btn_web_close"
            android:layout_width="34dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FF7777"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Standalone App WebView (Sits below top bar when shown, or 100% full screen in Installed Mode) -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/web_nav_bar"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Subtle Top-Right / Top-Center Pull Pill when Top Bar is Hidden in Installed App Mode -->
    <LinearLayout
        android:id="@+id/web_top_handle"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/dock_card"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="10dp"
        android:alpha="0.72"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/text_top_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▾ Bar"
            android:textColor="#DDFFFFFF"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Fullscreen Video / HTML5 Custom View Container -->
    <FrameLayout
        android:id="@+id/fullscreen_custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Thin Top Loading Progress Indicator -->
    <ProgressBar
        android:id="@+id/web_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_alignParentTop="true"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/btn_accent"
        android:visibility="gone" />

</RelativeLayout>
